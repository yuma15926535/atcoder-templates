    do {                                                                                        \
        if (!(__VA_ARGS__)) {                                                                   \
            std::cerr << "[{LABEL}] TEST FAILED  line " << __LINE__ << ": " #__VA_ARGS__ "\n"; \
            std::exit(1);                                                                       \
        }                                                                                       \
